# ============================================================
# CASA MAMÁ EMMA - Configuración del emisor (SRI Ecuador)
# Copiar este archivo a `.env` y completar los valores reales.
# ============================================================

# Base de datos SQLite (archivo local, respaldar con frecuencia)
DATABASE_URL="file:./casa-mama-emma.db"

# ---------- Datos del emisor ----------
SRI_RUC="1805034426001"
SRI_RAZON_SOCIAL="RUIZ JARA JUAN DAVID"
SRI_NOMBRE_COMERCIAL="Casa Mamá Emma"
# Dirección matriz y del establecimiento (texto libre, editable también en /ajustes)
SRI_DIR_MATRIZ="Baños de Agua Santa, Tungurahua, Ecuador"
SRI_DIR_ESTABLECIMIENTO="Baños de Agua Santa, Tungurahua, Ecuador"
SRI_OBLIGADO_CONTABILIDAD="NO"

# ---------- Numeración ----------
SRI_ESTABLECIMIENTO="001"
SRI_PUNTO_EMISION="001"

# ---------- Ambiente SRI ----------
# 1 = PRUEBAS (celcer.sri.gob.ec)  |  2 = PRODUCCIÓN (cel.sri.gob.ec)
# Empezar SIEMPRE en pruebas. Pasar a 2 solo tras validar en ambiente de certificación.
SRI_AMBIENTE="1"

# ---------- Firma electrónica ----------
# Ruta absoluta al certificado .p12 (Banco Central, Security Data, UANATACA, etc.)
SRI_P12_PATH="./certificados/firma.p12"
SRI_P12_PASSWORD="clave-del-certificado"

# ---------- Facturación ----------
# Tarifa IVA por defecto: 4 = 15% | 8 = 8% (feriados turísticos) | 0 = 0%
SRI_IVA_CODIGO_DEFECTO="4"
# Límite legal para ventas a CONSUMIDOR FINAL sin identificar (USD)
SRI_LIMITE_CONSUMIDOR_FINAL="50"

# ---------- Autenticación / sesiones ----------
# Secreto para firmar la cookie de sesión (HMAC). Mínimo 16 caracteres.
# Genera uno propio: openssl rand -base64 32
AUTH_SECRET="genera-un-secreto-largo-y-unico"

# Credenciales del administrador inicial (creado por el seed).
ADMIN_EMAIL="admin@casamamaema.com"
ADMIN_PASSWORD="cambia-esta-clave"

# ---------- Integraciones ----------
# URL pública de la app (para los enlaces al PDF en Google Calendar).
APP_URL="http://localhost:3000"

# Google Calendar (OAuth). Crea credenciales en Google Cloud Console
# (APIs y servicios → Credenciales → ID de cliente OAuth → App web) y
# añade la URI de redirección igual a GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integraciones/google/callback"

# ---------- Correo (SMTP) para enviar la factura autorizada al cliente ----------
# Si están vacías, el envío se omite sin romper la emisión. Ejemplo Gmail:
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT="587"  (usa una "contraseña de aplicación")
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Casa Mamá Emma <facturacion@casamamaema.com>"

# Airbnb: no requiere credenciales; la URL iCal se pega desde la app (/integraciones).

# ---------- Google Sheets (libro de gastos deducibles en la nube) ----------
# Cuenta de SERVICIO (no OAuth de usuario). Pasos:
#   1. Google Cloud Console → IAM y administración → Cuentas de servicio → Crear.
#   2. Esa cuenta → Claves → Agregar clave → JSON (se descarga un archivo).
#   3. Copia aquí el "client_email" y el "private_key" del JSON descargado.
#   4. Comparte tu hoja de Google Sheets con ese client_email, como Editor.
#   5. GOOGLE_SHEETS_SPREADSHEET_ID es el ID en la URL de la hoja:
#      https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""
