{
  "name": "casa-mama-emma-facturacion",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión y facturación electrónica SRI (esquema offline) para Casa Mamá Emma - Baños de Agua Santa, Ecuador",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "test:sri": "tsx scripts/test-sri.ts",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:dev": "electron electron"
  },
  "build": {
    "appId": "ec.casamamaemma.facturacion",
    "productName": "Casa Mama Emma",
    "directories": {
      "app": "electron",
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "servidor.js",
      "package.json"
    ],
    "extraResources": [
      { "from": ".next/standalone", "to": "app" },
      { "from": "electron/plantilla", "to": "plantilla" }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "CasaMamaEmma-Portable.exe"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.5.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.0",
    "next": "^14.2.15",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.10.1",
    "pdfmake": "^0.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfmake": "^0.2.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
